.gradle/
build/
app/build/
local.properties
.idea/
*.iml
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Native binaries are cross-built in CI (native/build-binaries.sh), never committed.
app/src/main/jniLibs/
build/native/

# Signing material never enters the repo.
*.jks
*.keystore
keystore.properties
# The debug keystore is intentionally checked in: CI runners are ephemeral
# and would otherwise mint a fresh debug key per run, forcing reinstalls
# between debug builds. Conventionally shareable; carries no trust.
!app/debug.keystore

# Artifacts live in CI / Releases.
*.apk
*.aab

.DS_Store
