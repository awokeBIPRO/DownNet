<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; these only need to exist and not flash. -->
    <style name="Theme.DownNet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Trampoline variant: invisible while it routes the share intent. -->
    <style name="Theme.DownNet.Translucent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
